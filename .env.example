    # 文字对话使用 DeepSeek；修改配置后重启应用生效。
VOLCENGINE_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
ARK_API_KEY=

# 语音同时使用上述三个 Key；双击 start.cmd 会自动准备缺失的本地唤醒模型。
# 唤醒后听到叮声再说话。交互项优先使用 UI 已保存值，尚未保存时读取下列初始值。
# 服务凭据与模型参数修改后重启生效；日常交互设置及生效时机见 docs/development.md。
VOICE_WAKE_WORD=你好小博
VOICE_WAKE_HOTKEY=Ctrl+\
VOICE_IDLE_TIMEOUT_SECONDS=60
