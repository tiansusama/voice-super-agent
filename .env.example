# 文字对话使用 DeepSeek；修改配置后重启应用生效。
VOLCENGINE_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
ARK_API_KEY=

# 语音同时使用上述三个 Key；本地唤醒模型先运行 ./scripts/prepare-wake-model.ps1 下载。
# 唤醒后听到叮声再说话。开发版交互配置暂从 .env 读取，修改后重启生效。
VOICE_WAKE_WORD=你好小博
VOICE_WAKE_HOTKEY=Ctrl+\
VOICE_IDLE_TIMEOUT_SECONDS=60
